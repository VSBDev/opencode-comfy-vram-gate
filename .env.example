# Copy this file to .env for a repository-local private configuration.
# Values in .env override JSON configuration and are never committed.

OCVRAM_OLLAMA_URL=http://127.0.0.1:11434
OCVRAM_OLLAMA_UNLOAD_POLICY=all
OCVRAM_COMFY_URL=http://127.0.0.1:8188
OCVRAM_MIN_FREE_RATIO=0.85
OCVRAM_RENDER_TIMEOUT_SECONDS=3600
OCVRAM_FORCE_BLOCKING=true
OCVRAM_STAGING_CLEANUP=false

# Optional. Uncomment and fill these only when temporary staging cleanup is needed.
# OCVRAM_HOST_INPUT_ROOT=
# OCVRAM_GENERATED_OUTPUT_ROOTS=

# Other optional settings:
# OCVRAM_OLLAMA_MODELS=model-a:tag,model-b:tag
# OCVRAM_MIN_FREE_MIB=24000
# OCVRAM_REQUEST_TIMEOUT_MS=15000
# OCVRAM_HANDOFF_TIMEOUT_SECONDS=120
# OCVRAM_POLL_MS=500
# OCVRAM_LOCK_PATH=
# OCVRAM_LOCK_TIMEOUT_SECONDS=120
# OCVRAM_LOCK_STALE_SECONDS=7200
# OCVRAM_LOCK_HEARTBEAT_MS=5000
# OCVRAM_HEAVY_TOOL_SUFFIXES=comfy_local_run_workflow,comfy_local_run_template,comfy_local_generate_image,comfy_local_vary_workflow
# OCVRAM_UPLOAD_TOOL_SUFFIX=comfy_local_upload_file
